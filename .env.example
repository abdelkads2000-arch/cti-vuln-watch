# =====================================================================
# CTI Vuln Watch — configuration des secrets
# Copier en .env (fait automatiquement par ./start.sh). Ne jamais commiter .env.
# Toute clé laissée vide => la source/le canal correspondant est désactivé
# proprement, le reste du pipeline continue de fonctionner.
# =====================================================================

# --- Général ---------------------------------------------------------
TZ=Europe/Paris
LOG_LEVEL=INFO

# --- Base de données -------------------------------------------------
# POSTGRES_PASSWORD est généré aléatoirement par ./start.sh au premier lancement.
POSTGRES_DB=cti
POSTGRES_USER=cti
POSTGRES_PASSWORD=
# Laisser vide pour utiliser le conteneur local. Renseigner pour pointer
# vers une base interne : postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=

# --- Sauvegardes ------------------------------------------------------
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# --- LLM (résumé / extraction uniquement) ------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Sources niveau 1 -------------------------------------------------
# NVD : sans clé 5 req/30 s, avec clé 50 req/30 s. https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# GitHub : token "fine-grained" en lecture seule, aucun scope sur des dépôts privés.
# Requis pour l'API GraphQL (Advisories) et la recherche de dépôts PoC.
# https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# --- Sources optionnelles ---------------------------------------------
VULNCHECK_API_KEY=
ATTACKERKB_API_KEY=
# Recherche large (filet de sécurité) — https://api-dashboard.search.brave.com/
BRAVE_SEARCH_API_KEY=

# --- Exposition passive (phase 2) ------------------------------------
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=

# --- Notifications ----------------------------------------------------
# Vide => mode dry-run (notifications dans les logs + interface web)
TEAMS_WEBHOOK_URL_FR=
TEAMS_WEBHOOK_URL_KR=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
JIRA_URL=
JIRA_USER=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# --- Interface web (phase 3) ------------------------------------------
WEB_ADMIN_USER=admin
# Généré aléatoirement par ./start.sh au premier lancement
WEB_ADMIN_PASSWORD=
